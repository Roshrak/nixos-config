# The custom-service manifest allows this helper's code only.
/dotfiles/.hermes/*
!/dotfiles/.hermes/agy_bridge.py

# Generated Noctalia runtime data; retain declarative settings/templates.
/dotfiles/.config/theme-profiles/**/clipboard
/dotfiles/.config/theme-profiles/**/clipboard/**
/dotfiles/.config/noctalia/**/clipboard
/dotfiles/.config/noctalia/**/clipboard/**
/dotfiles/.config/**/.catalog/
/dotfiles/.config/**/.noctalia-cache.json
/dotfiles/.config/**/.setup-complete
/dotfiles/.config/fcitx5/conf/cached_layouts
*.giant-backup-*

# Version the human-stage policy source while keeping all other local Hermes state private.
!/dotfiles/.hermes/plugins/
!/dotfiles/.hermes/plugins/human-stage-policy/
!/dotfiles/.hermes/plugins/human-stage-policy/**
!/dotfiles/.hermes/skills/
!/dotfiles/.hermes/skills/human-controlled-project-stages/
!/dotfiles/.hermes/skills/human-controlled-project-stages/**
/dotfiles/.hermes/plugins/human-stage-policy/__pycache__/

# Fresh hardware is imported into the host-specific source during installation.
/installation/hardware-configuration.nix
**/__pycache__/
*.pyc
