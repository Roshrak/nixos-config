#!/usr/bin/env bash
# sway-session-guarded — Exec target for sway.desktop (patched via dm-sessions-share in plasma.nix)
# Persists Sway's theme profile on session exit.
set -u

SAVE=/home/aesc/.local/bin/save-theme-profile
APPLY=/home/aesc/.local/bin/apply-theme-profile
SWAY=/run/current-system/sw/bin/sway

# Clean any lingering noctalia process from previous session
pkill -u "$(id -u)" -x noctalia >/dev/null 2>&1 || true

export THEME_PROFILE="sway"
export NOCTALIA_STATE_HOME="$HOME/.config/theme-profiles/sway/noctalia-state"
export KITTY_CONFIG_DIRECTORY="$HOME/.config/kitty/profiles/sway"

systemctl --user import-environment THEME_PROFILE NOCTALIA_STATE_HOME KITTY_CONFIG_DIRECTORY 2>/dev/null || true
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd THEME_PROFILE NOCTALIA_STATE_HOME KITTY_CONFIG_DIRECTORY 2>/dev/null || true
fi

"$APPLY" sway >/dev/null 2>&1 || true

on_exit() {
    "$SAVE" sway >/dev/null 2>&1 || true
}
trap on_exit EXIT TERM INT HUP

"$SWAY" "$@"
rc=$?

trap - EXIT
on_exit
exit "$rc"
