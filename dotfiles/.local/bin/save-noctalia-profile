#!/usr/bin/env bash
# save-noctalia-profile <mango|kde|niri>
# Persist the CURRENT Noctalia settings into the named session's profile,
# so the next login of that session reuses what you customized here.
set -euo pipefail

usage() {
    echo "Usage: save-noctalia-profile <mango|kde|niri>" >&2
    exit 2
}

[ $# -eq 1 ] || usage
profile="$1"
case " mango kde niri " in
    *" $profile "*) ;;
    *) usage ;;
esac

LIVE="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"
DEST="$HOME/.config/theme-profiles/$profile/noctalia-state.toml"

[ -f "$LIVE" ] || { echo "ERROR: $LIVE missing" >&2; exit 1; }

mkdir -p "$(dirname "$DEST")"
tmp="$(mktemp "$(dirname "$DEST")"/.save.XXXXXX)"
cp -a "$LIVE" "$tmp"
mv -f "$tmp" "$DEST"

echo "Saved current Noctalia state -> $DEST"
