#!/usr/bin/env bash
set -euo pipefail

geometry="$(hyprctl -j activewindow | jq -r '
  if (.at | length) == 2 and (.size | length) == 2 and
     .size[0] > 0 and .size[1] > 0 then
    "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"
  else empty end
')"
[ -n "$geometry" ] || exit 1

directory="$HOME/Pictures/Screenshots"
mkdir -p "$directory"
destination="$directory/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"
grim -g "$geometry" "$destination"
wl-copy --type image/png < "$destination"
