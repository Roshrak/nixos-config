#!/usr/bin/env bash
# mango-session-guarded — Exec target for mango.desktop (patched via
# dm-sessions-share in plasma.nix), replaces upstream bare `mango`.
#
# Purpose: persist the session's Noctalia state into the mango seed when the
# session ends, so in-session customizations (palette source, scheme,
# wallpaper, widgets) survive to the next mango login.
#
# Why a trap: when greetd ends the login it SIGTERMs the session scope's
# whole process tree - including this wrapper. A post-mango line would
# never run; the trap fires during logind's pre-SIGKILL window instead
# (KillStop timeout is 90s, the copy takes milliseconds).
set -u

SAVE=/home/aesc/.local/bin/save-noctalia-profile
MANGO=/run/current-system/sw/bin/mango

on_exit() {
    "$SAVE" mango >/dev/null 2>&1 || true
}
trap on_exit EXIT TERM INT

"$MANGO"
rc=$?

trap - EXIT
on_exit
exit "$rc"
