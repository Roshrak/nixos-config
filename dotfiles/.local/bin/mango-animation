#!/usr/bin/env bash
set -euo pipefail

PRESET="${1:-}"
CFG="$HOME/.config/mango/config.conf"
BACKUP="$CFG.before-animation-$(date +%F-%H%M%S)"

case "$PRESET" in
  soft|slide|bounce|fade|off) ;;
  *)
    echo "Usage: mango-animation {soft|slide|bounce|fade|off}"
    exit 1
    ;;
esac

cp "$CFG" "$BACKUP"

sed -i -E '
/^[[:space:]]*animations[[:space:]]*=/d
/^[[:space:]]*animation_type_(open|close)[[:space:]]*=/d
/^[[:space:]]*animation_fade_(in|out)[[:space:]]*=/d
/^[[:space:]]*fade(in|out)_begin_opacity[[:space:]]*=/d
/^[[:space:]]*zoom_(initial|end)_ratio[[:space:]]*=/d
/^[[:space:]]*animation_duration_(open|close)[[:space:]]*=/d
/^[[:space:]]*animation_curve_(open|close|opafadein|opafadeout)[[:space:]]*=/d
' "$CFG"

case "$PRESET" in
  soft)
    cat >> "$CFG" <<'CONFIG'
animations=1
animation_type_open=zoom
animation_type_close=zoom
animation_fade_in=1
animation_fade_out=1
zoom_initial_ratio=0.88
zoom_end_ratio=0.92
fadein_begin_opacity=0.45
fadeout_begin_opacity=0.80
animation_duration_open=260
animation_duration_close=220
animation_curve_open=0.22,1,0.36,1
animation_curve_close=0.4,0,0.2,1
CONFIG
    ;;

  slide)
    cat >> "$CFG" <<'CONFIG'
animations=1
animation_type_open=slide
animation_type_close=slide
animation_fade_in=1
animation_fade_out=1
fadein_begin_opacity=0.55
fadeout_begin_opacity=0.85
animation_duration_open=260
animation_duration_close=220
CONFIG
    ;;

  bounce)
    cat >> "$CFG" <<'CONFIG'
animations=1
animation_type_open=zoom
animation_type_close=zoom
animation_fade_in=1
animation_fade_out=1
zoom_initial_ratio=0.72
zoom_end_ratio=0.86
fadein_begin_opacity=0.35
fadeout_begin_opacity=0.75
animation_duration_open=340
animation_duration_close=240
animation_curve_open=0.34,1.56,0.64,1
animation_curve_close=0.22,1,0.36,1
CONFIG
    ;;

  fade)
    cat >> "$CFG" <<'CONFIG'
animations=1
animation_type_open=fade
animation_type_close=fade
animation_fade_in=1
animation_fade_out=1
fadein_begin_opacity=0.0
fadeout_begin_opacity=1.0
animation_duration_open=220
animation_duration_close=180
CONFIG
    ;;

  off)
    cat >> "$CFG" <<'CONFIG'
animations=0
animation_type_open=none
animation_type_close=none
CONFIG
    ;;
esac

if mango -c "$CFG" -p; then
  mmsg dispatch reload_config
  echo "Applied Mango animation preset: $PRESET"
else
  cp "$BACKUP" "$CFG"
  echo "Invalid config; restored $BACKUP"
  exit 1
fi
