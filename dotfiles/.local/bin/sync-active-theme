#!/usr/bin/env bash
# sync-active-theme
# Triggered by Noctalia event hooks (colors_changed, wallpaper_changed, theme_mode_changed).
# Persists dynamic theme generation into the active DE/WM profile in real-time,
# isolating Kitty, GTK, Qt, and compositor state from other environments.
set -euo pipefail

# 1. Determine active profile
PROFILE="${THEME_PROFILE:-}"
if [ -z "$PROFILE" ]; then
    case "${XDG_CURRENT_DESKTOP:-}" in
        *niri*|*Niri*) PROFILE="niri" ;;
        *sway*|*Sway*) PROFILE="sway" ;;
        *mango*|*Mango*) PROFILE="mango" ;;
        *KDE*|*kde*|*plasma*) PROFILE="kde" ;;
    esac
fi

if [ -z "$PROFILE" ]; then
    if pgrep -u "$(id -u)" -x niri >/dev/null 2>&1; then
        PROFILE="niri"
    elif pgrep -u "$(id -u)" -x sway >/dev/null 2>&1; then
        PROFILE="sway"
    elif pgrep -u "$(id -u)" -x mango >/dev/null 2>&1; then
        PROFILE="mango"
    elif pgrep -u "$(id -u)" -x plasmashell >/dev/null 2>&1; then
        PROFILE="kde"
    else
        PROFILE="niri"
    fi
fi

# KDE does not participate in Noctalia dynamic theming
[ "$PROFILE" = "kde" ] && exit 0

PROFILE_DIR="$HOME/.config/theme-profiles/$PROFILE"
mkdir -p "$PROFILE_DIR/kitty" "$PROFILE_DIR/gtk-3.0" "$PROFILE_DIR/gtk-4.0" "$PROFILE_DIR/qt5ct/colors" "$PROFILE_DIR/qt6ct/colors" "$PROFILE_DIR/noctalia-state"
mkdir -p "$HOME/.config/kitty/themes" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" "$HOME/.config/qt5ct/colors" "$HOME/.config/qt6ct/colors"

atomic_copy() {
    local from="$1" to="$2" tmpdir
    [ -f "$from" ] || return 0
    tmpdir="$(dirname "$to")"
    mkdir -p "$tmpdir"
    local tmp
    tmp="$(mktemp "$tmpdir/.sync.XXXXXX")"
    cp -a "$from" "$tmp"
    mv -f "$tmp" "$to"
}

# 2. Locate active wallpaper & template directory
WALLPAPER="${NOCTALIA_WALLPAPER_PATH:-}"
if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
    WALLPAPER="$(noctalia msg wallpaper-get 2>/dev/null || true)"
fi
if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
    STATE_FILE="${NOCTALIA_STATE_HOME:-$PROFILE_DIR/noctalia-state}/settings.toml"
    if [ -f "$STATE_FILE" ]; then
        WALLPAPER=$(grep -E '^\s*path\s*=' "$STATE_FILE" | head -n 1 | sed -E 's/.*path\s*=\s*"([^"]+)".*/\1/' || true)
    fi
fi

NOCTALIA_BIN="$(which noctalia 2>/dev/null || true)"
if [ -n "$NOCTALIA_BIN" ]; then
    REAL_BIN="$(readlink -f "$NOCTALIA_BIN")"
    TEMPLATE_DIR="$(dirname "$(dirname "$REAL_BIN")")/share/noctalia/assets/templates"
else
    TEMPLATE_DIR="/run/current-system/sw/share/noctalia/assets/templates"
fi

if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ] && [ -d "$TEMPLATE_DIR" ]; then
    TMP_WORK="$(mktemp -d /tmp/noctalia-sync.XXXXXX)"
    trap 'rm -rf "$TMP_WORK"' EXIT

    # 3. Render Kitty theme for this session
    if [ -f "$TEMPLATE_DIR/kitty/kitty.conf" ]; then
        if noctalia theme "$WALLPAPER" -r "$TEMPLATE_DIR/kitty/kitty.conf:$TMP_WORK/kitty.conf" >/dev/null 2>&1; then
            atomic_copy "$TMP_WORK/kitty.conf" "$HOME/.config/kitty/themes/${PROFILE}.conf"
            atomic_copy "$TMP_WORK/kitty.conf" "$PROFILE_DIR/kitty/theme.conf"
        fi
    fi

    # 4. Render GTK 3 & 4 CSS
    if [ -f "$TEMPLATE_DIR/gtk/gtk3.css" ]; then
        if noctalia theme "$WALLPAPER" -r "$TEMPLATE_DIR/gtk/gtk3.css:$TMP_WORK/gtk3.css" >/dev/null 2>&1; then
            atomic_copy "$TMP_WORK/gtk3.css" "$HOME/.config/gtk-3.0/noctalia.css"
            atomic_copy "$TMP_WORK/gtk3.css" "$PROFILE_DIR/gtk-3.0/noctalia.css"
        fi
    fi
    if [ -f "$TEMPLATE_DIR/gtk/gtk4.css" ]; then
        if noctalia theme "$WALLPAPER" -r "$TEMPLATE_DIR/gtk/gtk4.css:$TMP_WORK/gtk4.css" >/dev/null 2>&1; then
            atomic_copy "$TMP_WORK/gtk4.css" "$HOME/.config/gtk-4.0/noctalia.css"
            atomic_copy "$TMP_WORK/gtk4.css" "$PROFILE_DIR/gtk-4.0/noctalia.css"
        fi
    fi

    # Ensure GTK imports noctalia.css for this session
    for v in 3.0 4.0; do
        GTK_CSS="$HOME/.config/gtk-$v/gtk.css"
        if [ ! -f "$GTK_CSS" ] || ! grep -q 'noctalia\.css' "$GTK_CSS"; then
            printf "@import 'colors.css';\n\n@import url(\"noctalia.css\");\n" > "$GTK_CSS"
        fi
        atomic_copy "$GTK_CSS" "$PROFILE_DIR/gtk-$v/gtk.css"
    done

    # 5. Render Qt colors
    if [ -f "$TEMPLATE_DIR/qt/qtct.conf" ]; then
        if noctalia theme "$WALLPAPER" -r "$TEMPLATE_DIR/qt/qtct.conf:$TMP_WORK/qt.conf" >/dev/null 2>&1; then
            atomic_copy "$TMP_WORK/qt.conf" "$HOME/.config/qt5ct/colors/noctalia.conf"
            atomic_copy "$TMP_WORK/qt.conf" "$HOME/.config/qt6ct/colors/noctalia.conf"
            atomic_copy "$TMP_WORK/qt.conf" "$PROFILE_DIR/qt5ct/colors/noctalia.conf"
            atomic_copy "$TMP_WORK/qt.conf" "$PROFILE_DIR/qt6ct/colors/noctalia.conf"
        fi
    fi

    # 6. Window Manager Reactive Updates
    ACCENT_COLOR=""
    if command -v jq >/dev/null 2>&1; then
        ACCENT_COLOR=$(noctalia theme "$WALLPAPER" 2>/dev/null | jq -r '.primary // empty' 2>/dev/null || true)
    fi

    case "$PROFILE" in
        niri)
            [ -z "$ACCENT_COLOR" ] && ACCENT_COLOR="#ffb4a8"
            cat > "$HOME/.config/niri/colors.kdl" << EOF
// Generated automatically from Noctalia palette for Niri session
layout {
    border {
        active-color "${ACCENT_COLOR}"
        inactive-color "#45475a"
    }
}
EOF
            atomic_copy "$HOME/.config/niri/colors.kdl" "$PROFILE_DIR/colors.kdl"
            niri msg action reload-config 2>/dev/null || true
            ;;
        sway)
            [ -z "$ACCENT_COLOR" ] && ACCENT_COLOR="#89b4fa"
            cat > "$HOME/.config/sway/colors" << EOF
# Generated automatically from Noctalia palette for Sway session
client.focused          ${ACCENT_COLOR} #1e1e2e #cdd6f4 ${ACCENT_COLOR} ${ACCENT_COLOR}
client.focused_inactive #45475a #1e1e2e #a6adc8 #45475a #45475a
client.unfocused        #313244 #1e1e2e #6c7086 #313244 #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8 #f38ba8
EOF
            atomic_copy "$HOME/.config/sway/colors" "$PROFILE_DIR/colors"
            swaymsg reload 2>/dev/null || true
            ;;
        mango)
            [ -z "$ACCENT_COLOR" ] && ACCENT_COLOR="#89b4fa"
            HEX_ACCENT="${ACCENT_COLOR#'#'}"
            cat > "$HOME/.config/mango/noctalia.conf" << EOF
# Generated automatically from Noctalia palette for Mango session
focused_border_color=0x${HEX_ACCENT}ff
EOF
            atomic_copy "$HOME/.config/mango/noctalia.conf" "$PROFILE_DIR/colors.conf"
            mmsg dispatch reload_config 2>/dev/null || true
            ;;
    esac
fi

# 7. Backup live Noctalia state to profile directory
LIVE_STATE="${NOCTALIA_STATE_HOME:-$PROFILE_DIR/noctalia-state}/settings.toml"
if [ -f "$LIVE_STATE" ] && [ -s "$LIVE_STATE" ]; then
    atomic_copy "$LIVE_STATE" "$PROFILE_DIR/noctalia-state.toml"
    atomic_copy "$LIVE_STATE" "$PROFILE_DIR/noctalia-state/settings.toml"
fi

# 8. Signal Kitty instances to reload
pkill -SIGUSR1 -u "$(id -u)" -x kitty 2>/dev/null || true

# 9. Snapshot GSettings
if command -v gsettings >/dev/null 2>&1; then
    gtk_theme="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)"
    icon_theme="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || true)"
    cursor_theme="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || true)"
    cursor_size="$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null || true)"
    color_scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"
    font_name="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || true)"

    if [ -n "$gtk_theme" ] && [ "$gtk_theme" != "''" ]; then
        cat << GEOF > "$PROFILE_DIR/gsettings.sh"
#!/usr/bin/env bash
# Snapshot of $PROFILE gsettings
set -euo pipefail
gsettings_set() { gsettings set "\$1" "\$2" "\$3" 2>/dev/null || true; }
gsettings_set org.gnome.desktop.interface gtk-theme "$gtk_theme"
gsettings_set org.gnome.desktop.interface icon-theme "$icon_theme"
gsettings_set org.gnome.desktop.interface cursor-theme "$cursor_theme"
gsettings_set org.gnome.desktop.interface cursor-size "$cursor_size"
gsettings_set org.gnome.desktop.interface color-scheme "$color_scheme"
gsettings_set org.gnome.desktop.interface font-name "$font_name"
GEOF
        chmod +x "$PROFILE_DIR/gsettings.sh"
    fi
fi
