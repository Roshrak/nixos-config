#!/usr/bin/env bash
# apply-theme-profile <mango|kde|niri|sway>
# Stamps shared and session config files with the chosen session profile at login,
# so Mango, KDE, Niri, and Sway keep completely independent looks and state.
set -euo pipefail

PROFILE_ROOT="$HOME/.config/theme-profiles"
PROFILES=(mango kde niri sway)

usage() {
    echo "Usage: apply-theme-profile <mango|kde|niri|sway>" >&2
    exit 2
}

[ $# -eq 1 ] || usage
profile="$1"
case " ${PROFILES[*]} " in
    *" $profile "*) ;;
    *) usage ;;
esac

src="$PROFILE_ROOT/$profile"

atomic_copy() {
    local from="$1" to="$2" tmpdir
    [ -f "$from" ] || return 0
    tmpdir="$(dirname "$to")"
    mkdir -p "$tmpdir"
    local tmp
    tmp="$(mktemp "$tmpdir/.stamp.XXXXXX")"
    cp -a "$from" "$tmp"
    mv -f "$tmp" "$to"
}

# 1. GTK 3.0 & GTK 4.0 configuration
for ver in 3 4; do
    gtk_dir="$HOME/.config/gtk-$ver.0"
    mkdir -p "$gtk_dir"

    if [ -f "$src/gtk-$ver.0/settings.ini" ]; then
        atomic_copy "$src/gtk-$ver.0/settings.ini" "$gtk_dir/settings.ini"
    fi

    if [ "$profile" != "kde" ]; then
        if [ -f "$src/gtk-$ver.0/noctalia.css" ]; then
            atomic_copy "$src/gtk-$ver.0/noctalia.css" "$gtk_dir/noctalia.css"
        fi
        printf "@import 'colors.css';\n\n@import url(\"noctalia.css\");\n" > "$gtk_dir/gtk.css"
    else
        # In KDE, neutralize noctalia.css and ensure gtk.css only imports KDE Breeze colors
        printf '/* KDE session: Noctalia CSS inactive */\n' > "$gtk_dir/noctalia.css"
        printf "@import 'colors.css';\n" > "$gtk_dir/gtk.css"
    fi
done

# 2. GTK 2.0 configuration
if [ -f "$src/gtkrc-2.0" ]; then
    atomic_copy "$src/gtkrc-2.0" "$HOME/.gtkrc-2.0"
fi

# 3. GSettings / dconf
if [ -f "$src/gsettings.sh" ]; then
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
    # shellcheck disable=SC1090
    source "$src/gsettings.sh" 2>/dev/null || true
fi

# 4. Kitty theme & configuration isolation
mkdir -p "$HOME/.config/kitty/themes" "$HOME/.config/kitty/profiles/$profile"
if [ -f "$src/kitty/theme.conf" ]; then
    atomic_copy "$src/kitty/theme.conf" "$HOME/.config/kitty/themes/${profile}.conf"
    atomic_copy "$src/kitty/theme.conf" "$HOME/.config/kitty/profiles/$profile/theme.conf"
fi

# Ensure canonical ~/.config/kitty/kitty.conf has dynamic session inclusion
cat > "$HOME/.config/kitty/kitty.conf" << 'EOF'
# Shared Kitty base configuration
include /home/aesc/.config/kitty/common.conf

# Fallback default color theme
include /home/aesc/.config/kitty/themes/default.conf

# Active session theme selected via THEME_PROFILE (niri, sway, mango, kde)
include /home/aesc/.config/kitty/themes/${THEME_PROFILE}.conf
EOF

# Ensure compatibility if KITTY_CONFIG_DIRECTORY was set
cat > "$HOME/.config/kitty/profiles/$profile/kitty.conf" << EOF
# Kitty configuration for $profile session
include /home/aesc/.config/kitty/common.conf
include /home/aesc/.config/kitty/themes/$profile.conf
EOF

# 5. Qt 5 / Qt 6 colors
mkdir -p "$HOME/.config/qt5ct/colors" "$HOME/.config/qt6ct/colors"
if [ -f "$src/qt5ct/colors/noctalia.conf" ]; then
    atomic_copy "$src/qt5ct/colors/noctalia.conf" "$HOME/.config/qt5ct/colors/noctalia.conf"
elif [ -f "$src/qt5ct/noctalia.conf" ]; then
    atomic_copy "$src/qt5ct/noctalia.conf" "$HOME/.config/qt5ct/colors/noctalia.conf"
fi
if [ -f "$src/qt6ct/colors/noctalia.conf" ]; then
    atomic_copy "$src/qt6ct/colors/noctalia.conf" "$HOME/.config/qt6ct/colors/noctalia.conf"
elif [ -f "$src/qt6ct/noctalia.conf" ]; then
    atomic_copy "$src/qt6ct/noctalia.conf" "$HOME/.config/qt6ct/colors/noctalia.conf"
fi

# 6. Compositor-specific border/accent colors
case "$profile" in
    niri)
        if [ -f "$src/colors.kdl" ]; then
            atomic_copy "$src/colors.kdl" "$HOME/.config/niri/colors.kdl"
        fi
        ;;
    sway)
        if [ -f "$src/colors" ]; then
            atomic_copy "$src/colors" "$HOME/.config/sway/colors"
        fi
        ;;
    mango)
        if [ -f "$src/colors.conf" ]; then
            atomic_copy "$src/colors.conf" "$HOME/.config/mango/noctalia.conf"
        fi
        ;;
esac

# 7. Noctalia State Management
if [ "$profile" != "kde" ]; then
    STATE_DIR="$src/noctalia-state"
    mkdir -p "$STATE_DIR"

    # Maintain shared user assets (plugins, palettes, templates, clipboard)
    mkdir -p "$HOME/.local/state/noctalia"
    [ -d "$HOME/.local/state/noctalia/clipboard" ] && ln -sfn "$HOME/.local/state/noctalia/clipboard" "$STATE_DIR/clipboard"
    [ -d "$HOME/.local/state/noctalia/plugins" ] && ln -sfn "$HOME/.local/state/noctalia/plugins" "$STATE_DIR/plugins"
    [ -d "$HOME/.local/state/noctalia/community-palettes" ] && ln -sfn "$HOME/.local/state/noctalia/community-palettes" "$STATE_DIR/community-palettes"
    [ -d "$HOME/.local/state/noctalia/community-templates" ] && ln -sfn "$HOME/.local/state/noctalia/community-templates" "$STATE_DIR/community-templates"
    touch "$STATE_DIR/.setup-complete"

    if [ ! -f "$STATE_DIR/settings.toml" ] && [ -f "$src/noctalia-state.toml" ]; then
        atomic_copy "$src/noctalia-state.toml" "$STATE_DIR/settings.toml"
    fi

    # Mirror active profile state to global ~/.local/state/noctalia for any legacy readers
    if [ -f "$STATE_DIR/settings.toml" ]; then
        atomic_copy "$STATE_DIR/settings.toml" "$HOME/.local/state/noctalia/settings.toml"
    fi
fi

# 8. Propagate environment variables
export THEME_PROFILE="$profile"
systemctl --user set-environment THEME_PROFILE="$profile" 2>/dev/null || true

if [ "$profile" != "kde" ]; then
    export NOCTALIA_STATE_HOME="$src/noctalia-state"
    systemctl --user set-environment NOCTALIA_STATE_HOME="$src/noctalia-state" 2>/dev/null || true
else
    systemctl --user unset-environment NOCTALIA_STATE_HOME 2>/dev/null || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    if [ "$profile" != "kde" ]; then
        dbus-update-activation-environment --systemd THEME_PROFILE="$profile" NOCTALIA_STATE_HOME="$src/noctalia-state" 2>/dev/null || true
    else
        dbus-update-activation-environment --systemd THEME_PROFILE="$profile" 2>/dev/null || true
    fi
fi

# Signal Kitty instances to reload
pkill -SIGUSR1 -u "$(id -u)" -x kitty 2>/dev/null || true

echo "Theme profile applied: $profile"
