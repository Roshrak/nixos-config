#!/usr/bin/env bash
# apply-theme-profile <mango|kde|niri|sway>
# Stamps shared and session config files with the chosen session profile at login,
# so Mango, KDE, Niri, and Sway keep completely independent looks across reboots.
set -euo pipefail

PROFILE_ROOT="$HOME/.config/theme-profiles"
PROFILES=(mango kde niri sway)

usage() {
    echo "Usage: apply-theme-profile <mango|kde|niri|sway>" >&2
    exit 2
}

[ $# -eq 1 ] || usage
profile="$1"
case " ${PROFILES[*]} " in
    *" $profile "*) ;;
    *) usage ;;
esac

src="$PROFILE_ROOT/$profile"

atomic_copy() {
    local from="$1" to="$2" tmpdir
    tmpdir="$(dirname "$to")"
    mkdir -p "$tmpdir"
    local tmp
    tmp="$(mktemp "$tmpdir/.stamp.XXXXXX")"
    cp -a "$from" "$tmp"
    mv -f "$tmp" "$to"
}

# 1. GTK 3.0 & GTK 4.0 configuration
for ver in 3 4; do
    if [ -f "$src/gtk-$ver.0/settings.ini" ]; then
        atomic_copy "$src/gtk-$ver.0/settings.ini" "$HOME/.config/gtk-$ver.0/settings.ini"
    fi
done

# 2. GTK 2.0 configuration
if [ -f "$src/gtkrc-2.0" ]; then
    atomic_copy "$src/gtkrc-2.0" "$HOME/.gtkrc-2.0"
fi

# 3. GSettings / dconf
if [ -f "$src/gsettings.sh" ]; then
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
    # shellcheck disable=SC1090
    source "$src/gsettings.sh" 2>/dev/null || true
fi

# 4. Kitty configuration directory isolation
KITTY_TARGET_DIR="$HOME/.config/kitty/profiles/$profile"
mkdir -p "$KITTY_TARGET_DIR"

export KITTY_CONFIG_DIRECTORY="$KITTY_TARGET_DIR"
systemctl --user set-environment KITTY_CONFIG_DIRECTORY="$KITTY_TARGET_DIR" 2>/dev/null || true
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd KITTY_CONFIG_DIRECTORY="$KITTY_TARGET_DIR" 2>/dev/null || true
fi

# Restore this session's saved wallpaper theme for Noctalia sessions
if [ "$profile" != "kde" ]; then
    if [ -f "$src/kitty/noctalia.conf" ]; then
        atomic_copy "$src/kitty/noctalia.conf" "$HOME/.config/kitty/themes/noctalia.conf"
    fi
    if [ -f "$src/kitty/current-theme.conf" ] && [ -s "$src/kitty/current-theme.conf" ]; then
        atomic_copy "$src/kitty/current-theme.conf" "$KITTY_TARGET_DIR/current-theme.conf"
    fi
else
    # For KDE, restore KDE's own theme and kitten override if saved
    if [ -f "$src/kitty/theme.conf" ]; then
        atomic_copy "$src/kitty/theme.conf" "$KITTY_TARGET_DIR/theme.conf"
    fi
    if [ -f "$src/kitty/current-theme.conf" ] && [ -s "$src/kitty/current-theme.conf" ]; then
        atomic_copy "$src/kitty/current-theme.conf" "$KITTY_TARGET_DIR/current-theme.conf"
    fi
fi

# 5. Noctalia State
if [ -f "$src/noctalia-state.toml" ]; then
    mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia"
    atomic_copy "$src/noctalia-state.toml" "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"
fi

mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia"
echo "$(date '+%Y-%m-%d %H:%M:%S') applied=$profile" >> "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/.stamp.log"
echo "Theme profile applied: $profile"
