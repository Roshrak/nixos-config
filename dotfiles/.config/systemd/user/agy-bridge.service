[Unit]
Description=Antigravity Pro Bridge - Persistent Google AI Pro OpenAI Adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/aesc/.local/share/nix-roots/hermes-agent-env/bin/python3 /home/aesc/.hermes/agy_bridge.py
WorkingDirectory=/home/aesc/.hermes
Environment="PATH=/run/current-system/sw/bin:/home/aesc/.nix-profile/bin:/home/aesc/.local/bin:/usr/bin:/bin"
Environment="HOME=/home/aesc"
# Disable the outer adapter deadline; see ~/.hermes/agy_bridge.py.  The agy
# process still has an explicit long deadline, so a wedged request is bounded.
Environment="AGY_BRIDGE_TIMEOUT_SECONDS=0"
Environment="AGY_PRINT_TIMEOUT=24h"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
