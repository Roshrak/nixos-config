# Mango starter config for Noctalia v5
# Validate after login with: mango -c ~/.config/mango/config.conf -p

# Session environment
env=TERMINAL,kitty
env=NIXOS_OZONE_WL,1
env=MOZ_ENABLE_WAYLAND,1

# Noctalia provides the shell: bar, launcher, notifications, wallpaper, lock, etc.
exec-once=noctalia

# Appearance tuned to avoid double-blurring Noctalia layer surfaces.
blur=1
blur_layer=0
blur_optimized=1
blur_params_num_passes=2
blur_params_radius=5
blur_params_noise=0.02
blur_params_brightness=0.9
blur_params_contrast=0.9
blur_params_saturation=1.0
layer_animations=0
shadows=1
layer_shadows=0
shadow_only_floating=0
shadows_size=4
shadows_blur=12
shadows_position_x=2
shadows_position_y=2
shadowscolor=0x000000ff

animation_duration_move=300
animation_duration_tag=250
animation_curve_move=0.46,1.0,0.29,1
animation_curve_tag=0.46,1.0,0.29,1

# Laptop input
tap_to_click=1
tap_and_drag=1
disable_while_typing=1
trackpad_natural_scrolling=0
mouse_natural_scrolling=0
xkb_rules_layout=us
repeat_rate=30
repeat_delay=400

# Tiling appearance
gappih=6
gappiv=6
gappoh=10
gappov=10
borderpx=1.5
border_radius=10
no_border_when_single=0
no_radius_when_single=0
smartgaps=0
focuscolor=0x89b4faff
bordercolor=0x45475aff
urgentcolor=0xf38ba8ff
rootcolor=0x11111bff
sloppyfocus=1
warpcursor=1
focus_on_activate=1

# Keep the current main window on the left; new windows join the smaller right stack.
new_is_master=0
default_mfact=0.62
default_nmaster=1

# Use tile layout on tags 1-9.
tagrule=id:1,layout_name:tile
tagrule=id:2,layout_name:tile
tagrule=id:3,layout_name:tile
tagrule=id:4,layout_name:tile
tagrule=id:5,layout_name:tile
tagrule=id:6,layout_name:tile
tagrule=id:7,layout_name:tile
tagrule=id:8,layout_name:tile
tagrule=id:9,layout_name:tile

# Apps and shell panels
bind=SUPER,Return,spawn,kitty
bind=SUPER,space,spawn,noctalia msg panel-toggle launcher
bind=SUPER,s,spawn,noctalia msg panel-toggle control-center
bind=SUPER,comma,spawn,noctalia msg settings-toggle
bind=SUPER,e,spawn,nautilus
bind=SUPER,z,spawn,chromium
bind=SUPER,Escape,spawn,noctalia msg session lock
bind=SUPER+SHIFT,e,spawn,noctalia msg panel-toggle session
bind=NONE,Print,spawn,noctalia msg screenshot-region
bind=SUPER,v,spawn,noctalia msg panel-toggle clipboard
bind=ALT,Tab,spawn,noctalia msg window-switcher

# Window control
bind=SUPER,q,killclient,
bind=SUPER,f,togglefullscreen,
bind=SUPER+SHIFT,f,togglefloating,
bind=SUPER,n,switch_layout
bind=SUPER,r,reload_config
bind=SUPER+SHIFT,m,quit

# Focus windows
bind=SUPER,h,focusdir,left
bind=SUPER,l,focusdir,right
bind=SUPER,k,focusdir,up
bind=SUPER,j,focusdir,down
bind=SUPER,Tab,focusstack,next

# Move/swap windows
bind=SUPER+SHIFT,Return,zoom,
bind=SUPER+SHIFT,h,exchange_client,left
bind=SUPER+SHIFT,l,exchange_client,right
bind=SUPER+SHIFT,k,exchange_client,up
bind=SUPER+SHIFT,j,exchange_client,down

# Tags/workspaces
bind=SUPER,1,view,1,0
bind=SUPER,2,view,2,0
bind=SUPER,3,view,3,0
bind=SUPER,4,view,4,0
bind=SUPER,5,view,5,0
bind=SUPER,6,view,6,0
bind=SUPER,7,view,7,0
bind=SUPER,8,view,8,0
bind=SUPER,9,view,9,0
bind=SUPER+SHIFT,1,tag,1,0
bind=SUPER+SHIFT,2,tag,2,0
bind=SUPER+SHIFT,3,tag,3,0
bind=SUPER+SHIFT,4,tag,4,0
bind=SUPER+SHIFT,5,tag,5,0
bind=SUPER+SHIFT,6,tag,6,0
bind=SUPER+SHIFT,7,tag,7,0
bind=SUPER+SHIFT,8,tag,8,0
bind=SUPER+SHIFT,9,tag,9,0
bind=SUPER,Left,viewtoleft,0
bind=SUPER,Right,viewtoright,0

# Multiple monitors
bind=SUPER+ALT,Left,focusmon,left
bind=SUPER+ALT,Right,focusmon,right
bind=SUPER+ALT+SHIFT,Left,tagmon,left
bind=SUPER+ALT+SHIFT,Right,tagmon,right

# Hardware/media keys through Noctalia
bind=NONE,XF86AudioRaiseVolume,spawn,wpctl set-volume @DEFAULT_SINK@ 5%+
bind=NONE,XF86AudioLowerVolume,spawn,wpctl set-volume @DEFAULT_SINK@ 5%-
bind=NONE,XF86AudioMute,spawn,wpctl set-mute @DEFAULT_SINK@ toggle
bind=NONE,XF86AudioMicMute,spawn,noctalia msg mic-mute
bind=NONE,XF86MonBrightnessUp,spawn,noctalia msg brightness-up
bind=NONE,XF86MonBrightnessDown,spawn,noctalia msg brightness-down
bind=NONE,XF86AudioPlay,spawn,noctalia msg media toggle
bind=NONE,XF86AudioNext,spawn,noctalia msg media next
bind=NONE,XF86AudioPrev,spawn,noctalia msg media previous

# Mouse: Super + left drag moves, Super + right drag resizes.
mousebind=SUPER,btn_left,moveresize,curmove
mousebind=SUPER,btn_right,moveresize,curresize

source=~/.config/mango/noctalia.conf

# Hold Super and scroll to move through occupied workspaces.

# Fixed desktop navigation and cursor.
tag_carousel =1
axis_bind_apply_timeout =180
axisbind =SUPER,UP,viewtoleft
axisbind =SUPER,DOWN,viewtoright
cursor_theme =Bibata-Modern-Ice
cursor_size =24

# Move the focused window to another physical monitor.
# The final 1 keeps the same workspace/tag.
bind=SUPER+SHIFT,Left,tagmon,left,1
bind=SUPER+SHIFT,Right,tagmon,right,1
bind=SUPER+SHIFT,Up,tagmon,up,1
bind=SUPER+SHIFT,Down,tagmon,down,1

# Mango window overview
ov_tab_mode=0
overviewgappi=10
overviewgappo=30

bind=SUPER,o,toggleoverview

# Four-finger swipe up/down opens or closes overview
gesturebind=none,up,4,toggleoverview
gesturebind=none,down,4,toggleoverview
animations=1
animation_type_open=slide
animation_type_close=slide
animation_fade_in=1
animation_fade_out=1
fadein_begin_opacity=0.55
fadeout_begin_opacity=0.85
animation_duration_open=260
animation_duration_close=220
