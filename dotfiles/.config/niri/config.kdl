// ============================================================
// TONELICO NIRI
// Independent session: owns its Noctalia state via
// ~/.config/theme-profiles/niri (stamped before the shell starts).
// ============================================================


environment {
    DISPLAY ":0"
    XDG_CURRENT_DESKTOP "niri"

    TERMINAL "kitty"

    NIXOS_OZONE_WL "1"
    MOZ_ENABLE_WAYLAND "1"
}


// ============================================================
// STARTUP
// ============================================================

// Isolation: stamp Niri's OWN Noctalia/GTK/kitty state BEFORE the shell
// reads anything (absolute path: systemd-launched sessions lack
// ~/.local/bin in PATH).
spawn-at-startup "/home/aesc/.local/bin/apply-theme-profile" "niri"
spawn-at-startup "/home/aesc/.local/bin/clean-stray-sessions"

spawn-at-startup "noctalia"
spawn-at-startup "/run/current-system/sw/bin/lxqt-policykit-agent"


// ============================================================
// INPUT
// ============================================================

input {
    keyboard {
        xkb {
            layout "us"
        }

        repeat-rate 30
        repeat-delay 400
    }

    touchpad {
        tap
        drag-lock
        natural-scroll
        dwt
    }

    // Real sloppy-focus:
    // whichever window the pointer enters gets keyboard focus.
    //
    // Deliberately NO max-scroll-amount="0%".
    focus-follows-mouse
}


// ============================================================
// OVERVIEW
// ============================================================

overview {
    backdrop-color "#000000"
}


// ============================================================
// DWM-LIKE WINDOW APPEARANCE
// ============================================================

layout {
    // Mango DWM profile uses tiny gaps.
    gaps 2

    center-focused-column "never"

    // No thick Niri focus ring.
    focus-ring {
        off
    }

    // Thin square DWM-style window borders.
    //
    // Active window = blue.
    // Inactive windows = dark gray.
    border {
        on
        width 0.5

        active-color "#89b4fa"
        inactive-color "#45475a"
    }

    // DWM-style flat appearance.
    shadow {
        off
    }

    // Closest equivalent to Mango's mfact = 0.62.
    default-column-width {
        proportion 0.62
    }
}


// Request compositor-side decorations where applications support it.
prefer-no-csd


// Keep rectangular window geometry.
// No geometry-corner-radius.
// No clip-to-geometry.
// No rounded-window rules.

window-rule {
    draw-border-with-background false
}
hotkey-overlay {
    skip-at-startup
}

// ============================================================
// SCREENSHOTS
// ============================================================

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// ============================================================
// KEYBINDS
// ============================================================

binds {
    Mod+Shift+Slash {
        show-hotkey-overlay;
    }


    // --------------------------------------------------------
    // Applications / Noctalia
    // --------------------------------------------------------

    Mod+Return {
        spawn "kitty";
    }

    Mod+Space {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }

    Mod+S {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }

    Mod+Comma {
        spawn "noctalia" "msg" "settings-toggle";
    }

    Mod+E {
        spawn "nautilus";
    }

    Mod+Z {
        spawn "chromium";
    }

    Mod+Escape {
        spawn "noctalia" "msg" "session" "lock";
    }

    Mod+Shift+E {
        spawn "noctalia" "msg" "panel-toggle" "session";
    }

    Print {
        spawn "noctalia" "msg" "screenshot-region";
    }

    Mod+Print {
        screenshot-screen;
    }

    Ctrl+Print {
        screenshot-window;
    }

    Mod+V {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }

    Alt+Tab {
        spawn "noctalia" "msg" "window-switcher";
    }


    // --------------------------------------------------------
    // Window control
    // --------------------------------------------------------

    Mod+Q {
        close-window;
    }

    Mod+M {
        maximize-column;
    }

    Mod+F {
        fullscreen-window;
    }

    Mod+Shift+F {
        toggle-window-floating;
    }

    Mod+Shift+Alt+M {
        quit;
    }


    // --------------------------------------------------------
    // Focus
    // --------------------------------------------------------

    Mod+H {
        focus-column-left;
    }

    Mod+L {
        focus-column-right;
    }

    Mod+K {
        focus-window-up;
    }

    Mod+J {
        focus-window-down;
    }

    Mod+Tab {
        focus-window-down;
    }


    // --------------------------------------------------------
    // Move / swap
    // --------------------------------------------------------

    Mod+Ctrl+H {
        move-column-left;
    }

    Mod+Ctrl+L {
        move-column-right;
    }

    Mod+Ctrl+K {
        move-window-up;
    }

    Mod+Ctrl+J {
        move-window-down;
    }


    // --------------------------------------------------------
    // Workspaces
    // --------------------------------------------------------

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Left {
        focus-column-left;
    }

    Mod+Right {
        focus-column-right;
    }

    Mod+WheelScrollUp {
        focus-workspace-up;
    }

    Mod+WheelScrollDown {
        focus-workspace-down;
    }

    Mod+O {
        toggle-overview;
    }


    // --------------------------------------------------------
    // Monitors
    // --------------------------------------------------------

    Mod+Alt+Left {
        focus-monitor-left;
    }

    Mod+Alt+Right {
        focus-monitor-right;
    }

    Mod+Alt+Shift+Left {
        move-column-to-monitor-left;
    }

    Mod+Alt+Shift+Right {
        move-column-to-monitor-right;
    }

    Mod+Shift+Left {
        move-column-to-monitor-left;
    }

    Mod+Shift+Right {
        move-column-to-monitor-right;
    }

    Mod+Shift+Up {
        move-window-to-monitor-up;
    }

    Mod+Shift+Down {
        move-window-to-monitor-down;
    }


    // --------------------------------------------------------
    // Hardware / media
    // --------------------------------------------------------

    XF86AudioRaiseVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_SINK@" "5%+";
    }

    XF86AudioLowerVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_SINK@" "5%-";
    }

    XF86AudioMute {
        spawn "wpctl" "set-mute" "@DEFAULT_SINK@" "toggle";
    }

    XF86AudioMicMute {
        spawn "noctalia" "msg" "mic-mute";
    }

    XF86MonBrightnessUp {
        spawn "noctalia" "msg" "brightness-up";
    }

    XF86MonBrightnessDown {
        spawn "noctalia" "msg" "brightness-down";
    }

    XF86AudioPlay {
        spawn "noctalia" "msg" "media" "toggle";
    }

    XF86AudioNext {
        spawn "noctalia" "msg" "media" "next";
    }

    XF86AudioPrev {
        spawn "noctalia" "msg" "media" "previous";
    }
}
