# Sway configuration with Noctalia v5 shell
# Keybindings match the Mango, Niri, and Plasma environments

set $mod Mod4
set $term kitty

# Font for window titles
font pango:JetBrainsMono Nerd Font 10

# Cursor theme
seat * xcursor_theme Bibata-Modern-Ice 24

# Output configuration: External HDMI-A-1 is on the LEFT (pos 0 0), Built-in eDP-1 is on the RIGHT (pos 1920 0)
output HDMI-A-1 pos 0 0 res 1920x1080
output eDP-1 pos 1920 0 res 1920x1200

# Primary workspaces mapped to built-in laptop panel (eDP-1)
workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output HDMI-A-1
workspace 7 output HDMI-A-1
workspace 8 output HDMI-A-1
workspace 9 output HDMI-A-1

focus output eDP-1

# Input configuration
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

input type:keyboard {
    xkb_layout us
    repeat_delay 400
    repeat_rate 30
}

# Window appearance & gaps
default_border pixel 1
default_floating_border pixel 1
smart_borders on
hide_edge_borders --i3 smart
workspace_layout tabbed
gaps inner 0
gaps outer 0

# Catppuccin / Noctalia matching border colors
# class                 border  backgr. text    indicator child_border
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.focused_inactive #45475a #1e1e2e #a6adc8 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #6c7086 #313244   #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8

# Startup services
exec --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK KITTY_CONFIG_DIRECTORY
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK KITTY_CONFIG_DIRECTORY
exec --no-startup-id systemctl --user restart xdg-desktop-portal-wlr xdg-desktop-portal
exec --no-startup-id /home/aesc/.local/bin/clean-stray-sessions
exec --no-startup-id /home/aesc/.local/bin/apply-theme-profile sway
exec --no-startup-id lxqt-policykit-agent
exec --no-startup-id noctalia
exec --no-startup-id fcitx5 -d

# Application & shell keybindings (matching Mango & Niri)
bindsym $mod+Return exec $term
bindsym $mod+space exec noctalia msg panel-toggle launcher
bindsym $mod+s exec noctalia msg panel-toggle control-center
bindsym $mod+comma exec noctalia msg settings-toggle
bindsym $mod+e exec nautilus
bindsym $mod+z exec chromium
bindsym $mod+Escape exec noctalia msg session lock
bindsym $mod+Shift+e exec noctalia msg panel-toggle session
bindsym Print exec noctalia msg screenshot-region
bindsym $mod+v exec noctalia msg panel-toggle clipboard
bindsym Mod1+Tab exec noctalia msg window-switcher

# Hardware and media keys through Noctalia / WirePlumber
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec noctalia msg mic-mute
bindsym XF86MonBrightnessUp exec noctalia msg brightness-up
bindsym XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym XF86AudioPlay exec noctalia msg media toggle
bindsym XF86AudioNext exec noctalia msg media next
bindsym XF86AudioPrev exec noctalia msg media previous

# Window control (matching Mango & Niri)
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus next
bindsym $mod+Shift+Return focus parent

# Focus movement
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move / Swap focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Layout & Maximize modes
# Super+M = Toggle Maximized tab view (keeps Noctalia bar visible)
# Super+N = Switch Tiling Method (split, tabbed, stacking)
bindsym $mod+m layout toggle tabbed split
bindsym $mod+n layout toggle split tabbed stacking
bindsym $mod+b splith
bindsym $mod+w layout tabbed

# Workspaces (1-9)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Workspace navigation
bindsym $mod+Ctrl+Left workspace prev
bindsym $mod+Ctrl+Right workspace next

# Safe reload & quit (matching Mango SUPER+SHIFT+ALT,m and Niri Mod+Shift+Alt+M)
bindsym $mod+r reload
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+Mod1+m exit
