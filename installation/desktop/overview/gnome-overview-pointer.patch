+static gboolean
+process_overview_pointer (MetaDisplay        *display,
+                          MetaWindow         *window,
+                          const ClutterEvent *event)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  ClutterInputDevice *source = clutter_event_get_source_device (event);
+  unsigned int mask;
+  GHashTableIter iter;
+  gpointer item;
+
+  if (!source || clutter_event_get_button (event) != 2)
+    return FALSE;
+
+  /* Pair releases with their own device even if modifiers were released first. */
+  if (clutter_event_type (event) == CLUTTER_BUTTON_RELEASE)
+    return g_hash_table_remove (keys->overview_pointer_presses, source);
+  /* A fresh press repairs stale state if an input-capture filter consumed
+   * the earlier release. It must never suppress the next physical click. */
+  g_hash_table_remove (keys->overview_pointer_presses, source);
+
+  devirtualize_modifiers (keys, clutter_event_get_state (event), &mask);
+  mask = mask_from_event_params (keys, mask);
+  if (!keys->super_mask || mask != (keys->super_mask | CLUTTER_SHIFT_MASK))
+    return FALSE;
+
+  /* Reuse the registered keyboard action, its inhibition and Shell mode filter. */
+  g_hash_table_iter_init (&iter, keys->key_bindings);
+  while (g_hash_table_iter_next (&iter, &item, NULL))
+    {
+      MetaKeyBinding *binding = item;
+      if (g_strcmp0 (binding->name, "toggle-overview") != 0 ||
+          !binding->handler || !meta_key_binding_has_handler_func (binding) ||
+          (binding->flags & (META_KEY_BINDING_PER_WINDOW | META_KEY_BINDING_CUSTOM_TRIGGER)))
+        continue;
+      if (display->focus_window &&
+          !(binding->handler->flags & META_KEY_BINDING_NON_MASKABLE) &&
+          meta_window_shortcuts_inhibited (display->focus_window, source))
+        return FALSE;
+      if (meta_compositor_filter_keybinding (display->compositor, binding))
+        return FALSE;
+      g_hash_table_add (keys->overview_pointer_presses, g_object_ref (source));
+      invoke_handler (display, binding->handler, window, event, binding);
+      return TRUE;
+    }
+  return FALSE;
+}
+
+gboolean
+meta_keybindings_process_overview_release (MetaDisplay        *display,
+                                          const ClutterEvent *event)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  if (clutter_event_type (event) != CLUTTER_BUTTON_RELEASE ||
+      clutter_event_get_button (event) != 2)
+    return FALSE;
+  return g_hash_table_remove (keys->overview_pointer_presses,
+                              clutter_event_get_source_device (event));
+}
+
+static void
+on_overview_device_removed (ClutterSeat        *seat,
+                            ClutterInputDevice *device,
+                            MetaDisplay        *display)
+{
+  g_hash_table_remove (display->key_binding_manager.overview_pointer_presses,
+                       device);
 }
 
